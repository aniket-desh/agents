[Unit]
Description=Research compute policy controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=research-compute
Group=research-compute-clients
SupplementaryGroups=research-compute
WorkingDirectory=/var/lib/research-compute
Environment=HOME=/var/lib/research-compute
Environment=npm_config_cache=/var/lib/research-compute/.npm
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/research-agents/bin/research-compute daemon --config /etc/research-compute/config.json --state-dir /var/lib/research-compute --socket /run/research-compute/control.sock
Restart=on-failure
RestartSec=5
RuntimeDirectory=research-compute
RuntimeDirectoryMode=0750
# Containers bind this directory; keep its inode through service stop/restart.
RuntimeDirectoryPreserve=yes
StateDirectory=research-compute
StateDirectoryMode=0700
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/research-compute /run/research-compute

[Install]
WantedBy=multi-user.target
